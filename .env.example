# ==============================================================================
# DesignShield 全系統環境變數設定範例與技術手冊 (.env.example)
#
# 本檔案定義 DesignShield 系統所支援之所有環境變數及其預設值、格式範例與用途說明。
# 建立本機環境時，請將本檔案複製為 .env 並依部署需求調整設定值：
#   cp .env.example .env
#
# 注意事項：
# 1. 系統環境設定頁面 (SettingsView) 已全面與 .env 檔案雙向綁定。
# 2. 標註【動態生效】之變數（如保留天數、Level 1/2 LLM 開關），修改儲存後立即於新任務生效。
# 3. 標註【需重啟】之變數（如資料庫連接埠、主機 IP、目錄路徑），修改後需重啟服務器方能完全套用。
# ==============================================================================

# ==============================================================================
# 1. 網路與伺服器主機設定 (Server & Network)
# ==============================================================================

# 【需重啟】全系統集中主控之主機 IP 或網域名稱
# 說明: 更換主機、變更 IP 或綁定內部 DNS 網域時只需修改此處，前端與認證跳轉服務將自動套用。
# 範例: 192.168.1.16 或 designshield.local
SERVER_HOST=192.168.1.16

# 【需重啟】前端 Web 服務對外暴露之連接埠號 (Production Docker Nginx / Dev Vite)
# 預設: 8080
FRONTEND_PORT=8080

# 【需重啟】Langfuse 儀表板 NextAuth 登入跳轉之完整絕對網址
# 說明: 需設定為外部使用者瀏覽器存取的位址，以避免登入後被導向使用者本機 localhost。
# 範例: http://192.168.1.16:3000 或 http://${SERVER_HOST}:3000
LANGFUSE_NEXTAUTH_URL=http://${SERVER_HOST}:3000


# ==============================================================================
# 2. 核心資料庫連線配置 (PostgreSQL Database)
# ==============================================================================

# PostgreSQL 核心資料庫使用者名稱
POSTGRES_USER=designshield

# PostgreSQL 核心資料庫連線密碼
POSTGRES_PASSWORD=shield_secret_2026

# 資料庫名稱（儲存 DRC 規則庫、任務進度與 DBOS 執行狀態）
POSTGRES_DB=designshield_db

# 【需重啟】PostgreSQL 對外暴露之主機埠號（預設 5433 避免與主機現有 5432 衝突）
POSTGRES_HOST_PORT=5433

# 後端 SQLAlchemy 主資料庫連線字串
DATABASE_URL=postgresql://designshield:shield_secret_2026@localhost:5433/designshield_db

# DBOS Durable Execution 引擎任務狀態資料庫連線字串 (預設與主資料庫同源)
DBOS_SYSTEM_DATABASE_URL=postgresql://designshield:shield_secret_2026@localhost:5433/designshield_db


# ==============================================================================
# 3. LiteLLM 多模型服務串接與推論開關 (LiteLLM & LLM Fallback)
# ==============================================================================

# 【需重啟】選擇當前啟用之大語言模型提供商 (Provider)
# 支援清單: local (本地 vLLM/Ollama), gemini, openrouter, openai, anthropic, groq, deepseek
LITELLM_PROVIDER=local

# 【需重啟】大語言模型 API 服務端點網址 (API Base)
# 範例: 本地端點填 http://192.168.1.5:8000/v1；OpenRouter 填 https://openrouter.ai/api/v1；Gemini/OpenAI 官方端點可留空
LOCAL_LLM_URL=http://192.168.1.5:8000/v1

# 【需重啟】指定 LiteLLM 調用的模型名稱 (Model Name)
# 支援帶 provider 前綴之識別名稱，例如:
# - 本地模型: openai/qwen 或 openai/local-model
# - Google Gemini: gemini/gemini-2.5-flash
# - OpenRouter: openrouter/google/gemini-2.5-flash 或 openrouter/deepseek/deepseek-chat
LOCAL_LLM_MODEL=openai/qwen

# 【需重啟】API 存取認證金鑰 (本地端點未啟用鑑權時填 EMPTY)
LOCAL_LLM_API_KEY=EMPTY

# 【需重啟】Google Gemini 專屬金鑰 (選填，使用 gemini/* 系列模型時自動以本金鑰鑑權)
# 範例: AIzaSyxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=

# 【需重啟】OpenRouter 專屬金鑰 (選填，使用 openrouter/* 系列模型時自動以本金鑰鑑權)
# 範例: sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=

# 【動態生效】Level 1 零件分類 LLM 保底推論開關 (預設: true)
# 說明: 當 Level 1 元件未能命中任何 YAML 規則 (信心度 < 0.6) 時，是否呼叫大語言模型進行語意保底推論。
# - true (啟用): 發送微批次請求由 LLM 識別元件類別、次類別與功能角色，防止特殊元件漏檢。
# - false (停用): 跳過 LLM 分析，直接套用 Unknown/None 保底分類，零延遲、節省 Token 且適合純離線環境。
ENABLE_LEVEL1_LLM_FALLBACK=true

# 【動態生效】Level 2 網路拓撲 LLM 保底推論開關 (預設: true)
# 說明: 當 Level 2 網路未能命中任何 YAML 拓撲規則且名稱模糊 (信心度 < 0.6) 時，是否呼叫大語言模型進行語意保底推論。
# - true (啟用): 結合網路連接之 IC 引腳特徵由 LLM 判定匯流排類型或電源軌，防止非標準網路漏掉整組匯流排 DRC。
# - false (停用): 跳過 LLM 分析，直接套用 Signal/General_Signal 預設分類，完全依賴純規則演算法。
ENABLE_LEVEL2_LLM_FALLBACK=true


# ==============================================================================
# 4. 檔案儲存路徑與生命週期管理 (Storage & Retention)
# ==============================================================================

# 【需重啟】系統所有上傳、解壓縮中繼及檢測報告檔案存放之本機或掛載根目錄
STORAGE_DIR=./storage

# 【需重啟】使用者上傳之原始線路圖封裝檔暫存目錄
UPLOAD_DIR=./storage/uploads

# 【需重啟】解壓縮後之 OrCAD XML、Allegro 網表及圖譜快取處理目錄
STAGING_DIR=./storage/staging

# 【需重啟】DRC 報告產出與匯出目錄
REPORT_DIR=./storage/reports

# 【動態生效】未開始任務預設保留天數 (超過此天數將自動清理該任務及其上傳檔案與暫存目錄)
RETENTION_DAYS_UNSTARTED=2

# 【動態生效】已完成/失敗/取消任務預設保留天數 (超過此天數將自動清除該任務、產出報告與綁定檔案)
RETENTION_DAYS_FINISHED=5


# ==============================================================================
# 5. Langfuse 觀測與追蹤服務 (Observability - 選用服務)
# ==============================================================================

# 【需重啟】用於後端 LiteLLM 自動上報 LLM 推理追蹤數據至 Langfuse 的公開金鑰 (Public Key)
# 範例: pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_PUBLIC_KEY=

# 【需重啟】用於後端 LiteLLM 安全驗證與寫入 Telemetry 紀錄的私密金鑰 (Secret Key)
# 範例: sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=

# 【需重啟】Langfuse 伺服器端點 (Docker 內部網路填 http://langfuse:3000 或對外 http://192.168.1.16:3000)
LANGFUSE_HOST=http://localhost:3000
