# DesignShield 環境變數設定範例

# ==========================================
# 伺服器主機 IP 或網域 (全域集中設定，換機器或改網域只需修改此變數)
# ==========================================
SERVER_HOST=192.168.1.16

# 資料庫連線配置 (PostgreSQL)
POSTGRES_USER=designshield
POSTGRES_PASSWORD=shield_secret_2026
POSTGRES_DB=designshield_db
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://designshield:shield_secret_2026@localhost:5433/designshield_db
DBOS_SYSTEM_DATABASE_URL=postgresql://designshield:shield_secret_2026@localhost:5433/designshield_db

# 本地 LLM 服務 (OpenAI 相容協議)
LOCAL_LLM_URL=http://192.168.1.5:8000/v1
LOCAL_LLM_MODEL=openai/qwen
LOCAL_LLM_API_KEY=EMPTY

# 儲存目錄
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
STAGING_DIR=./storage/staging
REPORT_DIR=./storage/reports

# 檔案生命週期管理 (天數)
UPLOAD_RETENTION_DAYS=7

# 前端連接埠 (Prod Docker)
FRONTEND_PORT=8080

# 觀測性服務 (Langfuse - 可選)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# Langfuse 認證跳轉網址 (預設自動套用 SERVER_HOST，亦可自訂完整 URL)
LANGFUSE_NEXTAUTH_URL=http://${SERVER_HOST}:3000
